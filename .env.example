# TelnyxHotel settings. Copy to .env (npm run setup does it), or let `npm run setup`
# fill everything in: it only needs the API key.

# Your Telnyx API key: https://portal.telnyx.com/#/api-keys
TELNYX_API_KEY=KEY0xP...your-key-here

# The Telnyx AI Assistant behind the receptionist, created by `npm run setup`.
TELNYX_ASSISTANT_ID=
# The knowledge-base bucket (Telnyx Storage), created by `npm run setup`. Bucket
# names are unique across all Telnyx accounts, so setup picks a random suffix.
# KB_BUCKET=telnyxhotel-kb-1a2b3c4d
# KB_REGION=us-central-1

PORT=3000

# First login. On the first start, while there are no users yet, an admin is
# created with these credentials (setup generates the password; without one a
# random password is printed in the server log). Change it from Users & access.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# Signs the session cookies (setup generates one). Without it one is derived from
# TELNYX_API_KEY, so changing the key logs everyone out.
# SESSION_SECRET=

# Where the local SQLite database (users, call history, settings) lives.
# DATA_DIR=data
# Use a Telnyx Edge SQL database instead (over the REST API), as on Telnyx Edge.
# SQLDB_ID=

# Booking recap e-mails go out with the Telnyx Email API, set up in the app
# (E-mail page): nothing to configure here. Optional fallback while it is off:
# SMTP. With neither, the app only shows an in-browser preview of the e-mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="TelnyxHotel front desk <frontdesk@example.com>"
# SMTP fallback only: send every recap here instead of the guest's address.
# RECAP_OVERRIDE_TO=you@example.com

# On Telnyx Edge, set these as account secrets with a TELNYXHOTEL_ prefix
# (TELNYXHOTEL_TELNYX_API_KEY, TELNYXHOTEL_TELNYX_ASSISTANT_ID, TELNYXHOTEL_SQLDB_ID, …).
